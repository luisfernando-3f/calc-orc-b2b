# Copie para .env (ou .env.production) e defina um segredo forte.
# AUTH_SECRET assina o cookie de sessão. Sem ele, usa um fallback de dev
# (NÃO use o fallback em produção — qualquer um poderia forjar sessão).
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# URL do Inbound Webhook do GHL (location SEED) acionado ao clicar em
# "Gerar proposta". Sem ela, o envio ao GHL é ignorado silenciosamente.
GHL_WEBHOOK_URL_PROPOSTA=https://services.leadconnectorhq.com/hooks/SEU_LOCATION_ID/webhook-trigger/SEU_TRIGGER_ID

# Private Integration Token do GHL (location SEED) com escopo de leitura
# (opportunities.readonly, contacts.readonly). Usado para listar os leads em
# "Reunião agendada" e pré-preencher a calculadora. Sem ele, o seletor de
# lead simplesmente não aparece.
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID_SEED=DcnfB72uqgixvRSzi6Pi
