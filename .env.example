# Copie para .env (ou .env.production) e defina um segredo forte.
# AUTH_SECRET assina o cookie de sessão. Sem ele, usa um fallback de dev
# (NÃO use o fallback em produção — qualquer um poderia forjar sessão).
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Private Integration Token do GHL (location SEED) com escopo de leitura e
# escrita (opportunities.readonly/write, contacts.readonly). Usado para:
# - listar os leads em "Reunião agendada" e pré-preencher a calculadora
#   (sem ele, o seletor "Dados do CRM" simplesmente não aparece);
# - gravar nicho específico, ticket médio e ciclo de venda na oportunidade
#   ao clicar em "Gerar proposta" (chamada direta à API do GHL — não passa
#   mais por Inbound Webhook/workflow, que corrompia acento).
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID_SEED=DcnfB72uqgixvRSzi6Pi
